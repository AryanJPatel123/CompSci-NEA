<Window x:Class="CompSci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CompSci"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000" ResizeMode="NoResize">
    <Grid>
        <TabControl x:Name="Maintabcontrol" SelectionChanged="Maintabcontrol_SelectionChanged">
            <TabItem Header="Timetable">
                <Grid x:Name="grid1" Background="#FFE5E5E5">
                    <DataGrid x:Name="Timetable" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="62,50,458,179" CanUserDeleteRows="False" AutoGenerateColumns="True" CanUserAddRows="False" FrozenColumnCount="1" SelectionChanged="Timetable_SelectionChanged" />
                    <Button x:Name="committimetable" Content="Upload Timetable" HorizontalAlignment="Left" Margin="676,139,0,0" VerticalAlignment="Top" Height="70" Width="170" Click="committimetable_Click"/>
                    <Label x:Name="info" Content="" Margin="455,487,0,0"/>
                    <Button x:Name="download" Content="Download TimeTable" HorizontalAlignment="Left" Margin="676,265,0,0" VerticalAlignment="Top" Height="72" Width="170" Click="download_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Map" Height="20" VerticalAlignment="Bottom">
                <Grid x:Name="grid2" Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="317*"/>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition Width="477*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Run_Astar" Content="Run A*" Margin="253,464,17,11" Click="Run_Astar_Click" Grid.Column="2"/>
                    <Label Content="Start:" Margin="10,438,263,-62"/>
                    <Label Content="End:" Margin="100,438,173,-62"/>
                    <ListBox x:Name="ListBox1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="351,26,17,109" SelectionChanged="ListBox_SelectionChanged" Grid.Column="2"/>
                    <Button x:Name="filepath" Content="Select Database file" HorizontalAlignment="Left" Margin="92,464,0,0" VerticalAlignment="Top" Height="64" Width="141" Click="filepath_Click" Grid.Column="2"/>
                    <ComboBox x:Name="start" HorizontalAlignment="Left" Margin="10,492,0,0" VerticalAlignment="Top" Width="85" Height="22" IsEditable="True" SelectionChanged="start_SelectionChanged"/>
                    <ComboBox x:Name="end" HorizontalAlignment="Left" Margin="100,492,0,0" VerticalAlignment="Top" Width="85" Height="22" IsEditable="True" SelectionChanged="end_SelectionChanged"/>
                    <Label Content="Blocked" Margin="208,438,51,-62"/>
                    <ComboBox x:Name="blocked" Margin="208,491,91,19" IsEditable="True" SelectionChanged="blocked_SelectionChanged"/>
                    <TabControl x:Name="buildings" Margin="10,10,341,123" Grid.ColumnSpan="3">
                        <TabItem Header="Main Building">
                            <Grid Background="#FFE5E5E5" Height="301" Margin="0,0,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="0*"/>
                                </Grid.ColumnDefinitions>
                                <TabControl x:Name="building1" Margin="0,-39,0,-41">
                                    <TabItem Header="Floor 1">
                                        <Grid x:Name="grid6" Background="#FFE5E5E5" Margin="0,0,2,0" Height="348">
                                            <Image HorizontalAlignment="Left" Height="386" VerticalAlignment="Center" Width="559" RenderTransformOrigin="0.5,0.5" Source="/CompSci;component/MapPics/downstairs1.png" Margin="55,0,0,0">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform/>
                                                        <SkewTransform AngleY="0.264"/>
                                                        <RotateTransform/>
                                                        <TranslateTransform Y="0.407"/>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Label Content="Inner Q" HorizontalAlignment="Left" Margin="302,186,0,0" VerticalAlignment="Top"/>
                                            <Label Content="RS" HorizontalAlignment="Left" Margin="385,77,0,0" VerticalAlignment="Top"/>
                                            <Label Content="PH1" HorizontalAlignment="Left" Margin="174,72,0,0" VerticalAlignment="Top"/>
                                            <Label Content="PH2" HorizontalAlignment="Left" Margin="104,118,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MA3" HorizontalAlignment="Left" Margin="94,256,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MA2" HorizontalAlignment="Left" Margin="174,226,0,0" VerticalAlignment="Top"/>
                                            <Label Content="EXH" HorizontalAlignment="Left" Margin="320,226,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MA1" HorizontalAlignment="Left" Margin="397,221,0,0" VerticalAlignment="Top"/>
                                            <Label Content="LUNCH COR" HorizontalAlignment="Left" Margin="491,44,0,0" VerticalAlignment="Top"/>
                                            <Label Content="RECEP" HorizontalAlignment="Left" Margin="503,186,0,0" VerticalAlignment="Top"/>
                                            <Label Content="UGRH" HorizontalAlignment="Left" Margin="503,243,0,0" VerticalAlignment="Top"/>
                                            <Label Content="6CR" HorizontalAlignment="Left" Margin="503,90,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Floor 2">
                                        <Grid x:Name="grid7" Background="#FFE5E5E5">
                                            <Image HorizontalAlignment="Left" Height="353" Margin="32,0,0,0" VerticalAlignment="Center" Source="/CompSci;component/MapPics/upstairs.png" Width="569"/>
                                            <Label Content="ECON" HorizontalAlignment="Left" Margin="359,89,0,0" VerticalAlignment="Top"/>
                                            <Label Content="POL" HorizontalAlignment="Left" Margin="262,84,0,0" VerticalAlignment="Top"/>
                                            <Label Content="COMP" HorizontalAlignment="Left" Margin="192,79,0,0" VerticalAlignment="Top"/>
                                            <Label Content="CH" HorizontalAlignment="Left" Margin="112,79,0,0" VerticalAlignment="Top"/>
                                            <Label Content="EN3" HorizontalAlignment="Left" Margin="78,291,0,0" VerticalAlignment="Top"/>
                                            <Label Content="EN2" HorizontalAlignment="Left" Margin="138,248,0,0" VerticalAlignment="Top"/>
                                            <Label Content="LIBRARY" HorizontalAlignment="Left" Margin="262,248,0,0" VerticalAlignment="Top"/>
                                            <Label Content="EN1" HorizontalAlignment="Left" Margin="359,243,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="MFL/Bio/Classics/Art">
                            <Grid Background="#FFE5E5E5" Height="255">
                                <TabControl x:Name="building2" SelectionChanged="building2_SelectionChanged" Margin="0,-64,0,-72">
                                    <TabItem Header="Floor 1">
                                        <Grid x:Name="grid8" Background="#FFE5E5E5">
                                            <Image HorizontalAlignment="Left" Height="370" Margin="88,0,0,0" VerticalAlignment="Top" Width="424" Source="/CompSci;component/MapPics/biodown.png"/>
                                            <Label Content="Music" HorizontalAlignment="Left" Margin="232,122,0,0" VerticalAlignment="Top"/>
                                            <Label Content="BIODOWN" HorizontalAlignment="Left" Margin="166,208,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MFLDOWN" HorizontalAlignment="Left" Margin="246,278,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MFLCDOWN" HorizontalAlignment="Left" Margin="376,286,0,0" VerticalAlignment="Top"/>
                                            <Label Content="CLASSICS" HorizontalAlignment="Left" Margin="376,167,0,0" VerticalAlignment="Top"/>
                                            <Label Content="LECTURE" HorizontalAlignment="Left" Margin="410,70,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Floor 2">
                                        <Grid x:Name="grid9" Background="#FFE5E5E5">
                                            <Image HorizontalAlignment="Left" Height="367" Margin="106,0,0,0" VerticalAlignment="Center" Width="378" Source="/CompSci;component/MapPics/BIOUP.png"/>
                                            <Label Content="BIOUP" HorizontalAlignment="Left" Margin="145,184,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MFLUP" HorizontalAlignment="Left" Margin="233,292,0,0" VerticalAlignment="Top"/>
                                            <Label Content="MFLCUP" HorizontalAlignment="Left" Margin="343,287,0,0" VerticalAlignment="Top"/>
                                            <Label Content="ART" HorizontalAlignment="Left" Margin="355,192,0,0" VerticalAlignment="Top"/>
                                            <Label Content="ARTUP (UP STAIRS)" HorizontalAlignment="Left" Margin="417,39,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem HorizontalAlignment="Center" Height="20" Header="DT" VerticalAlignment="Center" Width="54">
                            <Grid Background="#FFE5E5E5" Height="266">
                                <TabControl x:Name="building3" Margin="0,-56,0,-63">
                                    <TabItem Header="Floor 1">
                                        <Grid x:Name="grid10" Background="#FFE5E5E5">
                                            <Image HorizontalAlignment="Left" Height="350" Margin="89,10,0,0" VerticalAlignment="Top" Width="398" Source="/CompSci;component/MapPics/DTDOWN.png"/>
                                            <Label Content="DTDOWN" HorizontalAlignment="Left" Margin="177,184,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Floor 2">
                                        <Grid x:Name="grid11" Background="#FFE5E5E5">
                                            <Image HorizontalAlignment="Left" Height="357" Margin="97,10,0,0" VerticalAlignment="Top" Width="453" Source="/CompSci;component/MapPics/DTUP.png"/>
                                            <Label Content="DTUP" HorizontalAlignment="Left" Margin="183,188,0,0" VerticalAlignment="Top"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem HorizontalAlignment="Center" Height="20" Header="Geography" VerticalAlignment="Center" Width="54">
                            <Grid x:Name="grid13" Background="#FFE5E5E5">
                                <Image HorizontalAlignment="Left" Height="406" Margin="10,0,0,0" VerticalAlignment="Top" Width="590" Source="/CompSci;component/MapPics/geog.png"/>
                            </Grid>
                        </TabItem>
                        <TabItem HorizontalAlignment="Center" Height="20" Header="Overview" VerticalAlignment="Center" Width="54">
                            <Grid x:Name="grid14" Background="#FFE5E5E5">
                                <Image HorizontalAlignment="Left" Height="395" VerticalAlignment="Center" Width="650" Source="/CompSci;component/MapPics/everything.png"/>
                                <Label Content="History" HorizontalAlignment="Left" Margin="68,145,0,0" VerticalAlignment="Top"/>
                                <Label Content="Geog" HorizontalAlignment="Left" Margin="46,114,0,0" VerticalAlignment="Top"/>
                                <Label Content="Mainbuilding" HorizontalAlignment="Left" Margin="52,274,0,0" VerticalAlignment="Top"/>
                                <Label Content="MFL/Bio/Classics/Art" HorizontalAlignment="Left" Margin="386,127,0,0" VerticalAlignment="Top"/>
                                <Label Content="DT" HorizontalAlignment="Left" Margin="281,84,0,0" VerticalAlignment="Top"/>
                                <Label Content="CCF" HorizontalAlignment="Left" Margin="248,10,0,0" VerticalAlignment="Top"/>
                                <Label Content="Sports" HorizontalAlignment="Left" Margin="151,32,0,0" VerticalAlignment="Top"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <Label Content="Stop" HorizontalAlignment="Left" Margin="346,438,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="stop1" HorizontalAlignment="Left" Margin="346,491,0,0" VerticalAlignment="Top" Width="87" IsEditable="True" SelectionChanged="stop1_SelectionChanged" Grid.ColumnSpan="3"/>
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Weather" VerticalAlignment="Center" Width="54">
                <Grid x:Name="grid3" Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="218*"/>
                        <RowDefinition Height="339*"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="weather0" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="31,39,783,328" Grid.RowSpan="2"/>
                    <ListBox x:Name="weather4" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="32,34,782,101" Grid.Row="1"/>
                    <ListBox x:Name="weather5" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="246,34,569,101" Grid.Row="1"/>
                    <ListBox x:Name="weather1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="245,39,570,328" Grid.RowSpan="2"/>
                    <ListBox x:Name="weather2" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="475,39,342,328" Grid.RowSpan="2"/>
                    <ListBox x:Name="weather6" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="476,34,341,101" Grid.Row="1"/>
                    <ListBox x:Name="weather7" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="707,33,110,101" Grid.Row="1"/>
                    <ListBox x:Name="weather3" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="707,39,110,328" Grid.RowSpan="2"/>
                    <Button x:Name="GetWeather" Content="Get Weather" HorizontalAlignment="Left" Margin="455,272,0,0" VerticalAlignment="Top" Height="49" Width="115" Click="GetWeather_Click_1" Grid.Row="1"/>
                    <TextBox x:Name="Location" TextWrapping="Wrap" Width="120" Margin="317,276,557,10" TextChanged="Location_TextChanged" Grid.Row="1"/>
                    <Label Content="Postcode:" Margin="317,236,570,62" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Teachers" VerticalAlignment="Center" Width="54">
                <Grid x:Name="grid4" Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125*"/>
                        <ColumnDefinition Width="679*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Teacher" HorizontalAlignment="Left" Height="28" Margin="50,41,0,0" VerticalAlignment="Top" Width="118" Grid.ColumnSpan="2"/>
                    <Label Content="Room" HorizontalAlignment="Left" Height="28" Margin="50,160,0,0" VerticalAlignment="Top" Width="172" Grid.ColumnSpan="2"/>
                    <DataGrid x:Name="TeacherDisplay" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="292,10,378,28" SelectionChanged="TeacherDisplay_SelectionChanged" Grid.Column="1"/>
                    <ComboBox x:Name="teacherdropdown" HorizontalAlignment="Left" Margin="50,86,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="dropdown1_SelectionChanged" IsEditable="True" Grid.ColumnSpan="2"/>
                    <ComboBox x:Name="roomdropdown" HorizontalAlignment="Left" Margin="50,203,0,0" VerticalAlignment="Top" Width="120" IsEditable="True" SelectionChanged="dropdown2_SelectionChanged" Grid.ColumnSpan="2"/>
                    <Button x:Name="resetfilter" Grid.Column="1" Content="Reset Filters" HorizontalAlignment="Left" Margin="115,203,0,0" VerticalAlignment="Top" Click="resetfilter_Click" Height="66" Width="136"/>
                    <Button x:Name="Applyfilter" Content="Apply Filters" Margin="115,62,588,424" Grid.Column="1" Click="Applyfilter_Click"/>
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Customize" VerticalAlignment="Center" Width="54">
                <Grid x:Name="grid5" Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="119*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="backbox" Grid.Column="1" HorizontalAlignment="Left" Margin="0,104,0,0" VerticalAlignment="Top" Width="120" Height="22" SelectionChanged="backbox_SelectionChanged"/>
                    <Label Grid.Column="1" Content="Background colour" HorizontalAlignment="Left" Margin="0,64,0,0" VerticalAlignment="Top" Height="26" Width="110"/>
                    <Label Content="Notification background" Margin="0,172,576,203" Grid.Column="1"/>
                    <ComboBox x:Name="notifbackcolour" Grid.Column="1" HorizontalAlignment="Left" Margin="0,222,0,0" VerticalAlignment="Top" Width="120" Height="22" SelectionChanged="textbox_SelectionChanged"/>
                    <Button x:Name="Apply" Grid.Column="1" Content="Apply settings" HorizontalAlignment="Left" Margin="176,147,0,0" VerticalAlignment="Top" Height="41" Width="136" Click="Apply_Click"/>
                    <Label Content="Notification text" Margin="0,273,576,102" Grid.Column="1"/>
                    <ComboBox x:Name="Notiftextcolour" HorizontalAlignment="Left" Margin="111,331,0,0" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="2" SelectionChanged="Notiftextcolour_SelectionChanged"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
